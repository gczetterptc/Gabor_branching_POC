#!/bin/sh

MSG_FILE="$1"

BRANCH=$(git branch --show-current)

# Extract ticket ID like ABC-123
TICKET=$(echo "$BRANCH" | grep -oE '[A-Z]+-[0-9]+')

# No ticket found, leave commit unchanged
[ -z "$TICKET" ] && exit 0

MSG=$(cat "$MSG_FILE")

# Avoid duplicates
case "$MSG" in
  "$TICKET:"*) exit 0 ;;
esac

printf "%s: %s" "$TICKET" "$MSG" > "$MSG_FILE"